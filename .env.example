# Copy to .env. Do not commit API keys.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/learning-squads.sqlite
# Optional: server-side OpenAI-compatible chat completions endpoint.
# AI_CHAT_ENDPOINT=https://your-provider.example/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
# Set the exact public origin and enable secure cookies behind HTTPS when hosting.
# APP_ORIGIN=https://learning-squads.example
# NODE_ENV=production
# COOKIE_SECURE=true
# Optional Google Meet: enable Google Meet API and create a Web OAuth client.
# Keep downloaded credentials outside Git; this file path is an alternative to client ID/secret.
# GOOGLE_OAUTH_CLIENT_FILE=C:/private/google-oauth-client.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Register this exact callback URI on the Google Web OAuth client.
# GOOGLE_REDIRECT_URI=https://your-public-host/api/google-meet/callback
# Persistent 32-byte base64 key for encrypted Google refresh tokens. Keep a backup.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# GOOGLE_TOKEN_ENCRYPTION_KEY=
